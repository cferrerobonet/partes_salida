#!/usr/bin/env bash
# Gancho de git (activar una vez con `make ganchos`). El repositorio es público:
# no deja hacer commit de datos del alumnado ni de secretos, ni de términos
# vetados (lista local, fuera del repositorio).
set -uo pipefail

fallo=0
vetados="${XDG_CONFIG_HOME:-$HOME/.config}/git/terminos-vetados"  # lista local, fuera del repositorio
while IFS= read -r -d '' f; do
    case "$f" in
        *.xls|*.xlsx|*.zip|*.bin|*.jpg|*.jpeg|*.dmg|*.exe)
            echo "pre-commit: $f parece un dato o un binario; no va en el repositorio público." >&2; fallo=1 ;;
        *Material\ de\ pruebas*|datos/*)
            echo "pre-commit: $f está en una carpeta de datos." >&2; fallo=1 ;;
        *.png|*.webp|*.heic|*.gif|*.bmp|*.tif|*.tiff)
            case "$f" in
                imagenes/*.png|src/partes_salida/recursos/*.png|docs/capturas/*.png) ;;
                *) echo "pre-commit: $f es una imagen fuera de las carpetas permitidas (¿una foto del alumnado?)." >&2; fallo=1 ;;
            esac ;;
    esac
    case "$(basename "$f")" in
        *,*) echo "pre-commit: $f tiene forma de «APELLIDOS, NOMBRE»: no se sube." >&2; fallo=1 ;;
    esac
    case "$f" in
        *.png|*.ico|*.icns|*.ttf|*.pdf) continue ;;
    esac
    if [ -s "$vetados" ] && git show ":$f" 2>/dev/null | grep -qwFf "$vetados"; then
        echo "pre-commit: término vetado en $f." >&2; fallo=1
    fi
    # Asignación de un literal a algo llamado contraseña o secreto (password = "…").
    if git show ":$f" 2>/dev/null | grep -nEi '(password|passwd|contrase(n|ñ)a|secreto?|smtp_pass)[a-z_]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'{}<>[:space:]]{6,}["'"'"']' | grep -q .; then
        echo "pre-commit: $f parece llevar una contraseña escrita." >&2; fallo=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# Comprobación común a todas las apps: contraseñas, servidores, usuarios del hosting, buzones (ADR-015)
bash "$(git rev-parse --show-toplevel)/scripts/comprobar_secretos.sh" --preparado || fallo=1

[ $fallo -eq 0 ] || { echo "Commit cancelado. Si es un falso positivo, explicarlo a CarlosFB antes de saltarlo." >&2; exit 1; }
exit 0
